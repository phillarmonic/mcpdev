{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phillarmonic.dev/mcpdev/scenario/suite.v1.json",
  "title": "mcpdev scenario suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "target", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "target": { "$ref": "#/$defs/target" },
    "protocol": { "enum": ["auto", "2025-11-25", "2026-07-28"] },
    "defaults": { "$ref": "#/$defs/defaults" },
    "variables": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "propertyNames": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/secret" },
      "propertyNames": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
    },
    "setup": { "type": "array", "items": { "$ref": "#/$defs/hook" } },
    "cleanup": { "type": "array", "items": { "$ref": "#/$defs/cleanupHook" } },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "duration": { "type": "string", "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$" },
    "jsonPath": { "type": "string", "pattern": "^(\$|/).+" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": { "$ref": "#/$defs/duration" },
        "connect_timeout": { "$ref": "#/$defs/duration" }
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_env"],
      "properties": { "from_env": { "type": "string", "minLength": 1 } }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "as": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
          }
        },
        "exec": { "$ref": "#/$defs/exec" }
      }
    },
    "cleanupHook": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "exec": { "$ref": "#/$defs/exec" } }
    },
    "exec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "cwd": { "type": "string" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "steps"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "timeout": { "$ref": "#/$defs/duration" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "inspect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["tools", "prompts", "resources", "templates", "all"] }
          }
        },
        "call": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool"],
          "properties": {
            "tool": { "type": "string", "minLength": 1 },
            "arguments": {
              "type": "object",
              "description": "Opaque tools/call JSON. Keys such as command are tool parameters, not target.command."
            }
          }
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "arguments": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "read": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uri": { "type": "string" },
            "template": { "type": "string" },
            "arguments": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compare"],
          "properties": {
            "compare": { "type": "string", "minLength": 1 },
            "fail_on": { "enum": ["metadata", "additive", "breaking"] },
            "ignore": { "type": "array", "items": { "type": "string" } },
            "rename": { "type": "array", "items": { "type": "string" } }
          }
        },
        "expect_failure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category"],
          "properties": { "category": { "$ref": "#/$defs/errorCategory" } }
        },
        "capture": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "path": { "$ref": "#/$defs/jsonPath" }
            }
          }
        },
        "assert": {
          "type": "array",
          "items": { "$ref": "#/$defs/assertion" }
        }
      }
    },
    "errorCategory": {
      "enum": ["usage", "connection", "protocol", "assertion", "interface_change", "incomplete", "internal", "tool_error"]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "equal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "$ref": "#/$defs/jsonPath" },
            "value": true,
            "variable": { "type": "string" }
          }
        },
        "contains": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "value"],
          "properties": {
            "path": { "$ref": "#/$defs/jsonPath" },
            "value": true
          }
        },
        "json_path": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "$ref": "#/$defs/jsonPath" },
            "exists": { "type": "boolean" },
            "count": { "type": "integer", "minimum": 0 }
          }
        },
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "$ref": "#/$defs/jsonPath" },
            "schema": { "type": "object" },
            "file": { "type": "string" }
          }
        },
        "content_type": {
          "type": "object",
          "additionalProperties": false,
          "required": ["equals"],
          "properties": { "equals": { "type": "string", "minLength": 1 } }
        },
        "latency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max"],
          "properties": { "max": { "$ref": "#/$defs/duration" } }
        },
        "error_category": {
          "type": "object",
          "additionalProperties": false,
          "required": ["equals"],
          "properties": { "equals": { "$ref": "#/$defs/errorCategory" } }
        }
      }
    }
  }
}
